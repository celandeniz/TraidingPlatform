# Vibe-Trading sidecar config. Copy to agent.env (gitignored) and fill in ONE
# LLM provider. This file configures the CONTAINER only — it is separate from our
# backend's own .env and must never share broker credentials.
#
# SAFETY: do NOT add any broker keys (Alpaca / IBKR / OKX / Binance, etc.) here.
# Vibe is allowed to PROPOSE orders only; proposals route back through our OMS,
# guards, and the live-trading hard-block. Vibe never trades directly.

# ============================================================================
# LLM Provider — pick ONE block (others commented). See Vibe docs for the full
# list of 13+ providers; the two most common are below.
# ============================================================================

# --- OpenRouter (multi-model gateway, Vibe's default) ---
LANGCHAIN_PROVIDER=openrouter
LANGCHAIN_MODEL_NAME=deepseek/deepseek-v4-pro
OPENROUTER_API_KEY=sk-or-v1-your-key-here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# --- Ollama (local, no key; reaches host Ollama via host.docker.internal) ---
# LANGCHAIN_PROVIDER=ollama
# LANGCHAIN_MODEL_NAME=qwen2.5:32b
# OLLAMA_BASE_URL is injected by docker-compose (host.docker.internal:11434)

# LLM parameters
LANGCHAIN_TEMPERATURE=0.0
TIMEOUT_SECONDS=120
MAX_RETRIES=2

# ============================================================================
# Data sources (all optional; free sources need no keys)
# ============================================================================
# A-shares (optional): https://tushare.pro  — falls back to AKShare if unset
# TUSHARE_TOKEN=
# HK/US equities via yfinance, crypto via OKX/CCXT: free, no config.

# ============================================================================
# API server / security
# ============================================================================
# Empty = loopback-only dev mode (fine for the sidecar's 127.0.0.1 bind).
# Set this ONLY if you ever expose :8899 beyond localhost.
# API_AUTH_KEY=

# Keep shell tools OFF — they are an arbitrary-code-execution surface.
VIBE_TRADING_ENABLE_SHELL_TOOLS=0

# Opt-in local cache for backtest loaders (speeds up repeated backtests).
# VIBE_TRADING_DATA_CACHE=1
