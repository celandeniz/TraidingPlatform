# Copy to .env and fill in. NEVER commit .env.
# Defaults are paper/test oriented. Live adapters also require LIVE_TRADING=true.

# Alpaca credentials for equities. Use paper keys unless LIVE_TRADING is enabled intentionally.
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_BASE_URL=https://paper-api.alpaca.markets
ALPACA_DATA_FEED=iex

# CCXT crypto exchange credentials. Sandbox/testnet is controlled by the active profile.
CCXT_API_KEY=
CCXT_SECRET_KEY=
CCXT_EXCHANGE=binance

# LLM provider keys. Optional; agents degrade gracefully without them.
# Ollama needs no key; run it locally at http://localhost:11434.
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=

# Optional market-data provider keys.
FMP_API_KEY=
POLYGON_API_KEY=
INTRINIO_API_KEY=
TIINGO_TOKEN=
ALPHA_VANTAGE_API_KEY=

# Runtime gates. PROFILE selects config profile; LIVE_TRADING must be true for real-money adapters.
LIVE_TRADING=false
TRADING_MODE=paper
PROFILE=test

# Feature toggles live in backend/config.yaml, not here:
# scanner, auto_trader, scheduler, snapshots, news_rss, perspective, reflection,
# execution.realistic_fills, and risk/guards all default off or paper-safe.
