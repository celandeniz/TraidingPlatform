# Copy to .env and fill in. NEVER commit .env.
# Regenerate keys in the Alpaca dashboard if they have ever been shared.

ALPACA_API_KEY=
ALPACA_API_SECRET=
ALPACA_PAPER_BASE_URL=https://paper-api.alpaca.markets
ALPACA_DATA_FEED=iex            # iex (free) | sip (Algo Trader Plus)
TRADING_MODE=paper              # paper | live  (Phase 1 is always paper)

# Phase 2 AI layer (Claude). Optional; agents degrade gracefully without it.
ANTHROPIC_API_KEY=

# Phase 3 live + crypto. Live orders need LIVE_TRADING=true AND per-order confirm.
LIVE_TRADING=false              # gate: true required before any real-money order
CCXT_API_KEY=                   # Binance testnet API key (sandbox)
CCXT_API_SECRET=
CCXT_EXCHANGE=binance
