# Copy to .env and fill in. NEVER commit .env.

# Alpaca credentials for equities. Use paper keys unless LIVE_TRADING is enabled intentionally.
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# CCXT crypto exchange credentials. Sandbox/testnet is controlled by the active profile.
CCXT_API_KEY=
CCXT_SECRET_KEY=
CCXT_EXCHANGE=binance

# LLM provider keys. Optional; agents degrade gracefully without them.
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=

# Optional market-data provider keys.
FMP_API_KEY=
POLYGON_API_KEY=

# Runtime gates. PROFILE selects config profile; LIVE_TRADING must be true for real-money adapters.
LIVE_TRADING=false
TRADING_MODE=paper
PROFILE=test
